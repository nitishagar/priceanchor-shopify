/**
 * Deploy-only Wrangler config: points at the PREBUILT output of
 * `npm run build` (./dist/server/index.js + ./dist/client assets).
 * Used as: npm run build && npx wrangler deploy --config wrangler.deploy.jsonc
 * A separate file is required because wrangler.jsonc's `main` must reference
 * source (./workers/app.ts) for `react-router build` to pass config
 * validation, while deploy must consume the built bundle (esbuild cannot
 * resolve the vite virtual import in the source entry).
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "priceanchor",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/server/index.js",
  "assets": {
    "directory": "./dist/client"
  },
  "vars": {
    "SCOPES": "read_products,write_products",
    "SHOPIFY_APP_URL": "https://priceanchor.applair.in"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
